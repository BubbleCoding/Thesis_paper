\newlabel{sec:Questionnaire}{{B}{98}{Questionnaire}{appendix.B}{}}
\newlabel{app:questionnaire-results}{{B}{98}{Questionnaire}{appendix.B}{}}
\newlabel{question 1}{{1}{98}{Q1: Did you participate in one of the Dungeons \& Dragons sessions recorded for this project?}{questioncounter.1}{}}
\newlabel{question 2}{{2}{98}{Q2: Did you read the comic book before filling out this questionnaire?}{questioncounter.2}{}}
\newlabel{question 3}{{3}{98}{Q3: How familiar are you with comic books as a storytelling format?}{questioncounter.3}{}}
\newlabel{question 4}{{4}{98}{Q4: To what extent do you feel that the Game Master's exposition is present in the comic book?}{questioncounter.4}{}}
\newlabel{question 5}{{5}{99}{Q5: To what extent do you feel that your in-character roleplay actions are conveyed in the comic book?}{questioncounter.5}{}}
\newlabel{question 6}{{6}{99}{Q6: To what extent do you feel that your actions as a player (choices, decisions, initiatives) are conveyed in the comic book?}{questioncounter.6}{}}
\newlabel{question7}{{7}{99}{Q7: Did you notice any text or visuals in the comic that explicitly referenced game rules (e.g., dice rolls, checks, modifiers)? About how many times did you notice this?}{questioncounter.7}{}}
\newlabel{question 8}{{8}{99}{Q8: Would you like rule interactions to be part of the comic book?}{questioncounter.8}{}}
\newlabel{question 9}{{9}{100}{Q9: Of the three activities (exposition, roleplay, rule interaction), which do you feel was represented best in the comic? Why?}{questioncounter.9}{}}
\newlabel{question 10}{{10}{100}{Q10: To what extent do you feel that the story told in the comic book still belongs to you and your group, even though it was generated by AI?}{questioncounter.10}{}}
\newlabel{question 11}{{11}{100}{Q11: Did the comic include anything you felt was inappropriate, offensive, or misaligned with the spirit of your group’s play?}{questioncounter.11}{}}
\newlabel{question 11 sub}{{12}{100}{Q11-sub: If yes, please describe what stood out and why}{questioncounter.12}{}}
\newlabel{question 12}{{13}{101}{Q12: Do you believe it is ethically acceptable to use AI systems to retell personal play sessions (such as D\&D) in the form of a comic book?}{questioncounter.13}{}}
\newlabel{question 13}{{14}{101}{Q13: Why do or do you not think it is ethically acceptable?}{questioncounter.14}{}}
\newlabel{question 14}{{15}{101}{Q14: Did the comic capture the feeling or atmosphere of the session for you? Why or why not?}{questioncounter.15}{}}
\newlabel{question 15}{{16}{102}{Q15: Was there anything important from the session that you feel was missing or underrepresented in the comic? Please explain}{questioncounter.16}{}}
\newlabel{question 16}{{17}{102}{Q16: How easy was it to follow the story in the comic compared to how you experienced the original session?}{questioncounter.17}{}}
\newlabel{question 17}{{18}{103}{Q17: To what extent did the comic capture important aspects of the session (characters, key events, mood)?}{questioncounter.18}{}}
\newlabel{question 18}{{19}{103}{Q18: How well did the text and images in the comic work together to retell the session?}{questioncounter.19}{}}
\newlabel{question 19}{{20}{103}{Q19: Did the comic feel like a valuable retelling of the session for you and your group? Why or why not?}{questioncounter.20}{}}
\newlabel{question 20}{{21}{104}{Q20: If you could improve one aspect of the comic generator, what would it be and why?}{questioncounter.21}{}}
